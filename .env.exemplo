DB_HOST=localhost
DB_PORT=5432
DB_NAME=suspiro_central
DB_USER=postgres
DB_PASSWORD=
SERVER_PORT=8080
AUTH_LOGIN_MAX_FAILED_ATTEMPTS=5
AUTH_LOGIN_LOCK_DURATION_MINUTES=15


SUPER_ADMIN_CPF=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NOME=Administrador SUSpiro


JWT_SECRET=
JWT_EXPIRATION=86400000
JWT_FIRST_ACCESS_EXPIRATION_MS=600000



FRONTEND_URL=http://localhost:5173
# Em produção: informe a origem HTTPS exata. Várias origens podem ser separadas por vírgula.

# SMTP do provedor de e-mail. Para Gmail, ative a verificação em duas etapas e gere uma Senha de app.
# MAIL_USERNAME deve ser a conta que enviará as mensagens; MAIL_FROM normalmente é o mesmo endereço.
# Nunca use a senha comum da conta nem envie seu .env para o repositório.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Verifica lembretes e e-mails pendentes a cada hora (3600000 ms).
GUIAS_NOTIFICACAO_INTERVALO_MS=3600000
GUIAS_NOTIFICACAO_ATRASO_INICIAL_MS=60000

GUIAS_NOTIFICACAO_BATCH_SIZE=100
GUIAS_NOTIFICACAO_MAX_ITENS_POR_CICLO=1000
GUIAS_NOTIFICACAO_RETRY_MINUTES=60

# Notificações de requisições legadas: confirmação/reprocessamento e lembrete após 5 dias.
REQUISICOES_NOTIFICACAO_INTERVALO_MS=3600000
REQUISICOES_NOTIFICACAO_ATRASO_INICIAL_MS=75000

# Ative apenas quando necessário; a documentação exige perfil SUPER_ADMIN.
SWAGGER_ENABLED=false
